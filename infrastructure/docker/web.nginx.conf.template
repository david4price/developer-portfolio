# Rendered by the nginx image's envsubst step (see web.security-headers.inc.template).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Security headers live in one snippet (rendered from web.security-headers.inc.template). Any
    # add_header in a location stops nginx inheriting the server's, so every location that adds
    # its own header includes the snippet again.
    include /etc/nginx/conf.d/security-headers.inc;

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    location /_next/static/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    error_page 404 /404.html;
}
