{
  "name": "developer-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Modular developer portfolio: static Next.js site, NestJS API, BullMQ worker",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b --pretty false && pnpm --filter @portfolio/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm monitoring:files",
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "tsc -b --pretty false && concurrently --kill-others-on-fail --names api,worker,web --prefix-colors blue,magenta,green \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @portfolio/api dev",
    "dev:web": "tsc -b --pretty false && pnpm --filter @portfolio/web dev",
    "dev:worker": "pnpm --filter @portfolio/worker dev",
    "db:migrate": "tsc -b --pretty false && pnpm --filter @portfolio/api db:migrate",
    "db:seed": "tsc -b --pretty false && pnpm --filter @portfolio/api db:seed",
    "db:reset": "node scripts/db-reset.mjs",
    "new:project": "node scripts/new-project.mjs",
    "format": "prettier --write .",
    "monitoring:files": "node scripts/check-monitoring-files.mjs",
    "helm:check": "bash infrastructure/helm/check-chart.sh && bash infrastructure/monitoring/check-monitoring.sh",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "tsc -b --pretty false && pnpm -r --if-present test",
    "test:integration": "tsc -b --pretty false && pnpm --filter @portfolio/api test:integration",
    "typecheck": "tsc -b --pretty false && pnpm --filter @portfolio/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
