# Copy to `.env` and replace every `change-me` value. `.env` is git-ignored.
# Every value here is a local-development placeholder, never a production secret.

NODE_ENV=development
LOG_LEVEL=log

# --- Docker Compose services (compose.yaml) ---------------------------------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# Use URL-safe characters only (letters, digits, - _ .); it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API and worker running on the host (pnpm dev:api / dev:worker) --------
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgres://portfolio:change-me-local-only@localhost:5432/portfolio
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
WORKER_CONCURRENCY=1

# --- AI (off by default; see docs/architecture/ai-integration.md) -----------
AI_ENABLED=false
# AI_PROVIDER=openai-compatible
# AI_MODEL=<model-id>
# AI_BASE_URL=http://<inference-host>:<port>/v1
# Required whenever AI_ENABLED=true. No challenge bypass, including local development.
# TURNSTILE_SECRET_KEY=<turnstile-secret-key>
# Comma-separated exact browser hostnames, without schemes, ports, paths, or wildcards.
# TURNSTILE_HOSTNAMES=portfolio.example.com
# Chat limits (defaults shown; see docs/architecture/ai-integration.md)
# CHAT_AI_MAX_CONCURRENCY=1
# CHAT_AI_QUEUE_MAX=4
# CHAT_AI_QUEUE_WAIT_MS=10000
# CHAT_SESSION_MESSAGE_LIMIT=30
# CHAT_IP_MESSAGES_PER_HOUR=60
# CHAT_IP_SESSIONS_PER_HOUR=10
# Only behind the Cloudflare tunnel, with a NetworkPolicy admitting only cloudflared:
# CHAT_TRUST_CF_CONNECTING_IP=false

# --- Web (inlined into the static build) ------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Fully containerized stack (compose.full.yaml) --------------------------
WEB_PORT=8080
PUBLIC_API_BASE_URL=http://localhost:3001
