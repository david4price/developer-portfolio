# Copy to `.env` and replace every `change-me` value. `.env` is git-ignored.
# Every value here is a local-development placeholder, never a production secret.

NODE_ENV=development
LOG_LEVEL=log

# --- Docker Compose services (compose.yaml) ---------------------------------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# Use URL-safe characters only (letters, digits, - _ .); it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API and worker running on the host (pnpm dev:api / dev:worker) --------
API_HOST=127.0.0.1
API_PORT=3001
# Prometheus metrics (GET /metrics) on their own port; keep the host on loopback.
API_METRICS_HOST=127.0.0.1
API_METRICS_PORT=9464
DATABASE_URL=postgres://portfolio:change-me-local-only@localhost:5432/portfolio
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
WORKER_CONCURRENCY=1

# --- AI (off by default; see docs/architecture/ai-integration.md) -----------
AI_ENABLED=false
# AI_PROVIDER=openai-compatible
# AI_MODEL=<model-id>
# AI_BASE_URL=http://<inference-host>:<port>/v1
# Required whenever AI_ENABLED=true. No challenge bypass, including local development.
# TURNSTILE_SECRET_KEY=<turnstile-secret-key>
# Comma-separated exact browser hostnames, without schemes, ports, paths, or wildcards.
# TURNSTILE_HOSTNAMES=portfolio.example.com
# The dog companion's name in the chat (letters, spaces, hyphens, apostrophes; max 30).
# CHAT_ASSISTANT_NAME=Pixel
# Chat limits (defaults shown; see docs/architecture/ai-integration.md)
# CHAT_AI_MAX_CONCURRENCY=1
# CHAT_AI_QUEUE_MAX=4
# CHAT_AI_QUEUE_WAIT_MS=10000
# CHAT_SESSION_MESSAGE_LIMIT=30
# CHAT_IP_MESSAGES_PER_HOUR=60
# CHAT_IP_SESSIONS_PER_HOUR=10
# Only behind the Cloudflare tunnel, with a NetworkPolicy admitting only cloudflared:
# CHAT_TRUST_CF_CONNECTING_IP=false
# Message screening: `rules`, or `classifier` (rules, then a CPU injection classifier; the API measured ~590 MiB with it).
# For `pnpm dev`, fetch the model first:
#   node apps/api/scripts/fetch-injection-classifier.mjs apps/api/models/injection-classifier
# CHAT_GUARD=rules
# CHAT_GUARD_MODEL_DIR=models/injection-classifier
# CHAT_GUARD_THRESHOLD=0.5
# CHAT_GUARD_TIMEOUT_MS=5000   # past it the message is refused as busy, never passed unscored
# Infrastructure Explorer snapshot: `disabled`, or `kubernetes` (inside a pod only, with the
# read-only Role from P6-01; the token and cluster CA come from the mounted service account).
# INFRASTRUCTURE_SOURCE=disabled
# INFRASTRUCTURE_NAMESPACE=portfolio

# Optional Argo CD deployment status (P6-03), with the Kubernetes infrastructure source enabled.
# Credentials stay in files mounted only into the API; no token in frontend settings.
# ARGOCD_ENABLED=false
# ARGOCD_SERVER_URL=https://argocd.example.com
# ARGOCD_APPLICATION=portfolio
# ARGOCD_PROJECT=portfolio
# ARGOCD_TOKEN_FILE=/run/secrets/argocd-token
# ARGOCD_CA_FILE=/run/secrets/argocd-ca.crt

# --- Web (inlined into the static build) ------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Public widget sitekey only. Unset keeps the chat page in its not-configured state.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-public-sitekey
# The dog companion's name in the chat popup for `pnpm dev`; keep it equal to
# CHAT_ASSISTANT_NAME (compose.full.yaml passes CHAT_ASSISTANT_NAME to the web build itself).
# NEXT_PUBLIC_ASSISTANT_NAME=Pixel

# --- Fully containerized stack (compose.full.yaml) --------------------------
WEB_PORT=8080
PUBLIC_API_BASE_URL=http://localhost:3001

# --- Local observability (compose.observability.yaml, opt-in, P9-08) ----------
# Grafana on http://localhost:${GRAFANA_PORT}, user admin. `pnpm bootstrap` generates this.
GRAFANA_ADMIN_PASSWORD=change-me-local-only
GRAFANA_PORT=3300
# Alloy reads container logs through the Docker socket; set this for rootless Docker, Colima, etc.
# DOCKER_SOCKET=/var/run/docker.sock
