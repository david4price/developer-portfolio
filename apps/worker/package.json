{
  "name": "@portfolio/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background job worker (BullMQ)",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && concurrently --kill-others --names compiler,worker \"tsc -b --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.spec.json && node --test .test-dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@portfolio/config": "workspace:*",
    "bullmq": "^6.7.2",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
