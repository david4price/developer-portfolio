{
  "name": "@portfolio/api",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio REST API (NestJS modular monolith)",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && concurrently --kill-others --names compiler,api \"tsc -b --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/database/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/database/seed.js",
    "test": "tsc -p tsconfig.spec.json && node --test .test-dist/test/*.test.js",
    "test:integration": "tsc -p tsconfig.spec.json && node --env-file-if-exists=../../.env --test .test-dist/test/integration/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@portfolio/config": "workspace:*",
    "@portfolio/project-registry": "workspace:*",
    "@portfolio/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11"
  }
}
